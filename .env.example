# Variables privadas: configúralas en Vercel y nunca las expongas al navegador.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL pública de producción, sin slash final. Se usa para canonical y Open Graph.
NEXT_PUBLIC_SITE_URL=https://comfeco.com

# Opcional. Puede ser un mailto: o la URL de un formulario de contacto.
NEXT_PUBLIC_PARTNERS_CONTACT_URL=mailto:comfeco.info@gmail.com
